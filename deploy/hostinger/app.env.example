# Install as /etc/tracker/app.env, root:root, mode 600. Never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
STORAGE_MODE=vps
DATABASE_URL=postgresql://tracker:REPLACE_DB_PASSWORD@127.0.0.1:5432/tracker
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Only needed for first creation of a missing root account. Does NOT reset users.
# ROOT_PASSWORD=REPLACE_WITH_UNIQUE_INITIAL_ADMIN_PASSWORD
